{
  "schema_version": 1,
  "source_id": "fantasypros",
  "ranking_kind": "adp",
  "ranking_family": "fantasypros-redraft-adp-composites",
  "applies_to_ranking_ids": [
    "redraft-ppr-overall",
    "redraft-half-ppr-superflex"
  ],
  "preferred_join_keys": [
    "source_player_id",
    "player_slug",
    "normalized_name_and_position"
  ],
  "preferred_snapshot_alignment": "same_day",
  "format_selection": {
    "QB": "redraft-half-ppr-superflex",
    "RB": "redraft-ppr-overall",
    "WR": "redraft-ppr-overall",
    "TE": "redraft-ppr-overall"
  },
  "rank_comparison": {
    "rule": "Normalize each ranking to a list-length-aware percentile before comparing sources or formats.",
    "raw_rank_difference_is_directly_comparable": false,
    "average_formats_together": false,
    "average_with_fantasy_football_calculator": false
  },
  "source_composition": {
    "fingerprint_required": true,
    "retain_dynamic_source_columns": true,
    "retain_missing_source_values": true,
    "retain_visible_source_dates": true,
    "composition_change_is_source_context_change": true,
    "interpret_as_player_movement_alone": false
  },
  "retention": {
    "raw_policy": "latest_only_complete_parsed_tables",
    "normalized_policy": "latest_four_changed_snapshots",
    "normalized_snapshot_count": 4,
    "same_day_changes_replace_snapshot": true
  },
  "derived_metrics": [
    "list_percentile",
    "previous_snapshot_percentile_delta",
    "three_snapshot_direction",
    "cross_provider_percentile_gap",
    "platform_rank_dispersion",
    "source_composition_changed"
  ],
  "limitations": [
    "FantasyPros does not document a league-size match for the actual six-team league on these pages.",
    "The PPR Overall feed does not model Superflex quarterback demand.",
    "The Half-PPR Superflex feed does not match full-PPR scoring.",
    "Neither feed models two fixed tight-end starters.",
    "The Real-Time and Superflex Overall field methodologies remain source fields unless FantasyPros documents them.",
    "Platform-level sample sizes are not published in the visible tables."
  ],
  "field_semantics_reference": "fantasy-management/sources/external-rankings/adp/fantasypros/README.md"
}
