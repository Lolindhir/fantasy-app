{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/sources/podcasts/stonedlack/schemas/stonedlack_take_schema.json",
  "title": "StonedLack Episode Extraction",
  "type": "object",
  "additionalProperties": true,
  "required": ["episode", "entities", "takes"],
  "properties": {
    "episode": {
      "type": "object",
      "required": ["episode_id", "source_name", "processed_date"],
      "properties": {
        "episode_id": { "type": "string" },
        "episode_number": { "type": ["integer", "null"] },
        "source_name": { "type": "string", "const": "StonedLack" },
        "title": { "type": ["string", "null"] },
        "published_date": { "type": ["string", "null"], "format": "date" },
        "processed_date": { "type": "string", "format": "date" },
        "raw_transcript_path": { "type": ["string", "null"] },
        "markdown_note_path": { "type": ["string", "null"] }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["entity_id", "canonical_name", "entity_type", "entity_confidence"],
        "properties": {
          "entity_id": { "type": "string" },
          "canonical_name": { "type": "string" },
          "entity_type": { "type": "string" },
          "position": { "type": ["string", "null"] },
          "team": { "type": ["string", "null"] },
          "college": { "type": ["string", "null"] },
          "transcript_mentions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verification_status": {
            "type": "string",
            "enum": ["verified", "unverified", "unresolved", "unknown"]
          },
          "verification_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "entity_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "../../../_ai/schemas/source-take.schema.json"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
