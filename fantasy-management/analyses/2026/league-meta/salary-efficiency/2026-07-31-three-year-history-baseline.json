  "hypotheses": [
    {
      "id": "SALARY-H01",
      "statement": "Spieler ohne drei vollständige Statistikjahre verzerren positionsbezogene Salary-Mediane nach unten, weil Salary häufig durch fehlende Historie oder Vertragszugehörigkeit reduziert ist.",
      "status": "proposed",
      "review_after": "2026-season-complete",
      "validation_result": null
    },
    {
      "id": "SALARY-H02",
      "statement": "Der Filter auf drei vollständige Statistikjahre erzeugt stabilere Salary-Ertrags-Grenzen als die ungefilterte Gesamtpopulation.",
      "status": "proposed",
      "review_after": "2026-season-complete",
      "validation_result": null
    },
    {
      "id": "SALARY-H03",
      "statement": "Der Drei-Jahres-Filter allein entfernt den Young-Player-Discount nicht vollständig; ein zusätzlicher Filter auf vertraglich etablierte Spieler liefert eine bessere Veteranen-Marktlinie.",
      "status": "proposed",
      "review_after": "2026-season-complete",
      "validation_result": null
    },
    {
      "id": "SALARY-H04",
      "statement": "Salary-Cut-offs müssen positions- und produktionsklassenbezogen abgeleitet werden; eine gemeinsame Kennzahl wie Punkte pro Million klassifiziert Rollen systematisch falsch.",
      "status": "proposed",
      "review_after": "2026-season-complete",
      "validation_result": null
    }
  ],
