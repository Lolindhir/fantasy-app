{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/podcast-mention-segment.schema.json",
  "title": "Podcast Authored Mention Segment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_schema_version",
    "episode_id",
    "source_id",
    "segment_id",
    "audit_pass",
    "status",
    "mentions"
  ],
  "properties": {
    "pipeline_schema_version": {
      "type": "integer",
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "audit_pass": {
      "type": "string",
      "const": "independent_second_pass"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complete",
        "needs_rework"
      ]
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "mention": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "entity_type",
        "raw_entity_mentions",
        "entity",
        "entity_resolution",
        "mention_types",
        "occurrences",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "player",
            "coach",
            "team",
            "college",
            "league",
            "other"
          ]
        },
        "raw_entity_mentions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_resolution": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "status",
            "method",
            "confidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "ambiguous",
                "unresolved"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "registry",
                "external_verification",
                "context_inference",
                "manual_confirmation",
                "none"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        },
        "mention_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ranking_subject",
              "substantive_take",
              "news_subject",
              "player_comparison",
              "depth_chart_context",
              "injury_context",
              "scheme_context",
              "historical_reference",
              "passing_reference",
              "unresolved",
              "false_positive"
            ]
          }
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "timestamp_start"
            ],
            "additionalProperties": true
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "episode_md",
            "standalone_take_required",
            "subject_take_ids",
            "context_take_ids"
          ],
          "properties": {
            "episode_md": {
              "type": "boolean"
            },
            "episode_md_section": {
              "type": [
                "string",
                "null"
              ]
            },
            "standalone_take_required": {
              "type": "boolean"
            },
            "subject_take_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "context_take_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_resolution": {
                "properties": {
                  "status": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_resolution": {
                "properties": {
                  "status": {
                    "enum": [
                      "ambiguous",
                      "unresolved"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "entity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mention_types": {
                "contains": {
                  "enum": [
                    "ranking_subject",
                    "substantive_take",
                    "news_subject"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "standalone_take_required": {
                    "const": true
                  },
                  "subject_take_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
