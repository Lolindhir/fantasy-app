{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-freshness-gate.schema.json",
  "title": "Fantasy Operations Source Freshness Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "generated_at",
    "berlin_date",
    "timezone",
    "morning_cycle",
    "population",
    "overall_status",
    "monitoring",
    "sources",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"const": "source-freshness-gate"},
    "generated_at": {"type": "string", "minLength": 1},
    "berlin_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "timezone": {"const": "Europe/Berlin"},
    "morning_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refresh_window_start", "catch_up_time", "monitoring_time"],
      "properties": {
        "refresh_window_start": {"type": "string"},
        "catch_up_time": {"type": "string"},
        "monitoring_time": {"type": "string"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "fresh_count", "stale_count", "missing_count", "failed_count", "invalid_count"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 1},
        "fresh_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0}
      }
    },
    "overall_status": {"enum": ["ok", "degraded", "blocked"]},
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "allowed",
        "no_event_conclusion_allowed",
        "unfresh_source_ids",
        "blocking_source_ids",
        "no_event_blocking_source_ids",
        "affected_signal_families"
      ],
      "properties": {
        "decision": {"enum": ["proceed", "proceed_degraded", "block"]},
        "allowed": {"type": "boolean"},
        "no_event_conclusion_allowed": {"type": "boolean"},
        "unfresh_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocking_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "no_event_blocking_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "affected_signal_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "label",
          "kind",
          "path",
          "status",
          "reason",
          "checked_at",
          "age_minutes",
          "block_monitoring_if_unfresh",
          "required_for_no_event_conclusion",
          "affected_signal_families"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["timestamp", "heartbeat"]},
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["fresh", "stale", "missing", "failed", "invalid"]},
          "reason": {"type": "string", "minLength": 1},
          "checked_at": {"type": ["string", "null"]},
          "age_minutes": {"type": ["number", "null"]},
          "content_changed": {"type": ["boolean", "null"]},
          "trigger": {"type": ["string", "null"]},
          "block_monitoring_if_unfresh": {"type": "boolean"},
          "required_for_no_event_conclusion": {"type": "boolean"},
          "affected_signal_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "freshness_basis", "unchanged_content_policy"],
      "properties": {
        "status": {"enum": ["ok", "degraded", "blocked"]},
        "freshness_basis": {"type": "string"},
        "unchanged_content_policy": {"type": "string"}
      }
    }
  }
}
