{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-freshness-gate.schema.json",
  "title": "Fantasy Operations Source Freshness Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "generated_at",
    "berlin_date",
    "timezone",
    "season_context",
    "morning_cycle",
    "population",
    "overall_status",
    "monitoring",
    "sources",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "dataset_id": {
      "const": "source-freshness-gate"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "berlin_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "const": "Europe/Berlin"
    },
    "morning_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refresh_window_start",
        "catch_up_time",
        "monitoring_time"
      ],
      "properties": {
        "refresh_window_start": {
          "type": "string"
        },
        "catch_up_time": {
          "type": "string"
        },
        "monitoring_time": {
          "type": "string"
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_count",
        "fresh_count",
        "stale_count",
        "missing_count",
        "failed_count",
        "invalid_count"
      ],
      "properties": {
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "fresh_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "overall_status": {
      "enum": [
        "ok",
        "degraded",
        "blocked"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "decision",
        "allowed",
        "no_event_conclusion_allowed",
        "signal_family_relevance",
        "unfresh_source_ids",
        "blocking_source_ids",
        "no_event_blocking_source_ids",
        "affected_signal_families"
      ],
      "properties": {
        "decision": {
          "enum": [
            "proceed",
            "proceed_degraded",
            "block",
            "inactive"
          ]
        },
        "allowed": {
          "type": "boolean"
        },
        "no_event_conclusion_allowed": {
          "type": "boolean"
        },
        "unfresh_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "blocking_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "no_event_blocking_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "affected_signal_families": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "signal_family_relevance": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "required",
              "secondary",
              "inactive"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "label",
          "kind",
          "path",
          "status",
          "reason",
          "checked_at",
          "age_minutes",
          "block_monitoring_if_unfresh",
          "required_for_no_event_conclusion",
          "affected_signal_families",
          "signal_family_relevance",
          "effective_block_monitoring_if_unfresh",
          "effective_required_for_no_event_conclusion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "timestamp",
              "heartbeat"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "fresh",
              "stale",
              "missing",
              "failed",
              "invalid"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "age_minutes": {
            "type": [
              "number",
              "null"
            ]
          },
          "content_changed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "trigger": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_monitoring_if_unfresh": {
            "type": "boolean"
          },
          "required_for_no_event_conclusion": {
            "type": "boolean"
          },
          "affected_signal_families": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "signal_family_relevance": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "required",
                "secondary",
                "inactive"
              ]
            }
          },
          "effective_block_monitoring_if_unfresh": {
            "type": "boolean"
          },
          "effective_required_for_no_event_conclusion": {
            "type": "boolean"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "freshness_basis",
        "unchanged_content_policy",
        "consumer_readiness_policy"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "blocked"
          ]
        },
        "freshness_basis": {
          "type": "string"
        },
        "unchanged_content_policy": {
          "type": "string"
        },
        "consumer_readiness_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "season_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "season",
        "as_of_date",
        "phase",
        "regular_season",
        "source"
      ],
      "properties": {
        "context_id": {
          "const": "nfl-regular-season-context"
        },
        "season": {
          "type": "integer",
          "minimum": 2000
        },
        "as_of_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "phase": {
          "enum": [
            "pre_regular_season",
            "regular_season",
            "post_regular_season"
          ]
        },
        "regular_season": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_game_date",
            "last_game_date",
            "current_week"
          ],
          "properties": {
            "first_game_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "last_game_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "current_week": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "game_type_basis"
          ],
          "properties": {
            "kind": {
              "const": "canonical_nfl_schedule"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "game_type_basis": {
              "const": "REG"
            }
          }
        }
      }
    }
  }
}
