{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy Episode",
  "type": "object",
  "additionalProperties": true,
  "required": ["episode_id", "source_id", "title"],
  "properties": {
    "episode_id": { "type": "string" },
    "source_id": { "type": "string" },
    "title": { "type": "string" },
    "published_date": { "type": ["string", "null"] },
    "processed_date": { "type": ["string", "null"] },
    "language": { "type": ["string", "null"] },
    "raw_path": { "type": ["string", "null"] },
    "topics": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "take_ids": { "type": "array", "items": { "type": "string" } }
  }
}
