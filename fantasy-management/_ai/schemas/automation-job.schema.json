{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/automation-job.schema.json",
  "title": "Fantasy Management Automation Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "enabled",
    "category",
    "description",
    "trigger",
    "dependencies",
    "execution",
    "output",
    "notification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "category": {
      "type": "string",
      "enum": [
        "monitoring",
        "league_review",
        "roster",
        "waiver",
        "market",
        "deadline",
        "draft",
        "season_review",
        "maintenance"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "notification": {
      "$ref": "#/$defs/notification"
    },
    "materiality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "active_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "ends_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "season_phases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "required",
        "condition"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "freshness_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "minimum_hours"
          ],
          "properties": {
            "type": {
              "const": "interval"
            },
            "minimum_hours": {
              "type": "integer",
              "minimum": 1
            },
            "retry_when_not_ready": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "days_of_week",
            "not_before_local_time"
          ],
          "properties": {
            "type": {
              "const": "calendar"
            },
            "days_of_week": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "MO",
                  "TU",
                  "WE",
                  "TH",
                  "FR",
                  "SA",
                  "SU"
                ]
              }
            },
            "not_before_local_time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "retry_when_not_ready": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "league_source",
            "final_week_field",
            "minimum_data_age_minutes",
            "retry_when_not_ready"
          ],
          "properties": {
            "type": {
              "const": "league_week_finalized"
            },
            "league_source": {
              "type": "string",
              "minLength": 1
            },
            "final_week_field": {
              "type": "string",
              "minLength": 1
            },
            "minimum_data_age_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "retry_when_not_ready": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sources",
            "comparison"
          ],
          "properties": {
            "type": {
              "const": "source_changed"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "comparison": {
              "type": "string",
              "enum": [
                "content_hash",
                "timestamp",
                "semantic"
              ]
            },
            "retry_when_not_ready": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "deadline_source",
            "offsets_days"
          ],
          "properties": {
            "type": {
              "const": "deadline_offset"
            },
            "deadline_source": {
              "type": "string",
              "minLength": 1
            },
            "offsets_days": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer"
              }
            },
            "retry_when_not_ready": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "manual"
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_ref",
        "perspective",
        "requires_external_research",
        "idempotency_key_template",
        "write_scope"
      ],
      "properties": {
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        },
        "perspective": {
          "type": "string",
          "enum": [
            "mighty_giants",
            "league",
            "global",
            "custom"
          ]
        },
        "requires_external_research": {
          "type": "boolean"
        },
        "idempotency_key_template": {
          "type": "string",
          "minLength": 1
        },
        "write_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "write_condition"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "notification_only",
            "analysis",
            "analysis_bundle",
            "state_only"
          ]
        },
        "markdown_path_template": {
          "type": "string",
          "minLength": 1
        },
        "json_path_template": {
          "type": "string",
          "minLength": 1
        },
        "write_condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "analysis_bundle"
              }
            }
          },
          "then": {
            "required": [
              "markdown_path_template",
              "json_path_template"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "analysis"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "markdown_path_template"
                ]
              },
              {
                "required": [
                  "json_path_template"
                ]
              }
            ]
          }
        }
      ]
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "minimum_severity",
        "include_no_change"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "always_on_completion",
            "material_changes_only",
            "critical_only",
            "silent_repo_output",
            "summary_only"
          ]
        },
        "minimum_severity": {
          "$ref": "#/$defs/severity"
        },
        "include_no_change": {
          "type": "boolean"
        }
      }
    }
  }
}
