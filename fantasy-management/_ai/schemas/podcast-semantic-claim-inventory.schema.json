{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Podcast semantic claim preflight inventory",
  "description": "Cue-anchored local claims; schema validity cannot prove semantic completeness or audio fidelity",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha256",
    "source_cue_range",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_cue_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "base_frozen_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_method": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "cue",
        "start_offset",
        "end_offset",
        "quote_hint",
        "kind",
        "claim",
        "review_state"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cue": {
          "type": "integer",
          "minimum": 1
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "quote_hint": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "verified",
            "needs_review",
            "context_only"
          ]
        },
        "review_note": {
          "type": "string"
        },
        "audit_reason": {
          "type": "string"
        },
        "linked_take_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
