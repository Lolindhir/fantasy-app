{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/automation-runner-config.schema.json",
  "title": "Fantasy Management Automation Runner Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_id",
    "enabled",
    "timezone",
    "managed_team",
    "mode",
    "job_discovery",
    "execution_policy",
    "state_policy",
    "notification_policy",
    "source_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "runner_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "enabled": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "managed_team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "identity_field",
        "team_id",
        "display_name_policy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "identity_field": {
          "type": "string",
          "minLength": 1
        },
        "team_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "display_name_policy": {
          "type": "string",
          "enum": [
            "resolve_current_from_source"
          ]
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "read_only",
        "proposal",
        "write_enabled"
      ]
    },
    "job_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "include",
        "exclude"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_jobs_per_run",
        "continue_on_job_error",
        "skip_when_dependencies_incomplete",
        "write_outputs_only_when_material",
        "retry_pending_jobs_on_next_wakeup"
      ],
      "properties": {
        "max_jobs_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "continue_on_job_error": {
          "type": "boolean"
        },
        "skip_when_dependencies_incomplete": {
          "type": "boolean"
        },
        "write_outputs_only_when_material": {
          "type": "boolean"
        },
        "retry_pending_jobs_on_next_wakeup": {
          "type": "boolean"
        }
      }
    },
    "state_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "one_file_per_job",
        "write_on",
        "keep_recent_events"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "one_file_per_job": {
          "type": "boolean",
          "const": true
        },
        "write_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "status_change",
              "material_change",
              "successful_output",
              "error_state_change"
            ]
          }
        },
        "keep_recent_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "notification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "minimum_severity",
        "bundle_notifications",
        "include_no_change_runs"
      ],
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "always_on_completion",
            "material_changes_only",
            "critical_only",
            "silent_repo_output",
            "summary_only"
          ]
        },
        "minimum_severity": {
          "$ref": "#/$defs/severity"
        },
        "bundle_notifications": {
          "type": "boolean"
        },
        "include_no_change_runs": {
          "type": "boolean"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_is_control_plane",
        "current_league_data_root",
        "fantasy_management_root",
        "refresh_dynamic_external_sources",
        "stored_analyses_are_not_current_truth"
      ],
      "properties": {
        "repo_is_control_plane": {
          "type": "boolean",
          "const": true
        },
        "current_league_data_root": {
          "type": "string",
          "minLength": 1
        },
        "fantasy_management_root": {
          "type": "string",
          "minLength": 1
        },
        "refresh_dynamic_external_sources": {
          "type": "boolean"
        },
        "stored_analyses_are_not_current_truth": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
