{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/episode-takes.schema.json",
  "title": "Podcast Episode Takes",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "episode_id",
    "source_id",
    "source_name",
    "take_categories"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "take_categories": {
      "type": "object",
      "required": [
        "players",
        "teams",
        "positions",
        "nfl",
        "fantasy",
        "other"
      ],
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/player_take"
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        },
        "nfl": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        },
        "fantasy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        },
        "other": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        }
      }
    }
  },
  "$defs": {
    "player_take": {
      "allOf": [
        {
          "$ref": "#/$defs/take"
        },
        {
          "type": "object",
          "required": [
            "raw_entity_mention",
            "entity_resolution"
          ],
          "properties": {
            "category": {
              "const": "players"
            },
            "raw_entity_mention": {
              "type": "string",
              "minLength": 1,
              "description": "Raw transcript/player mention before canonical name resolution."
            },
            "entity_resolution": {
              "$ref": "#/$defs/entity_resolution"
            }
          }
        }
      ]
    },
    "take": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "category",
        "type",
        "entity",
        "podcast_take"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "players",
            "teams",
            "positions",
            "nfl",
            "fantasy",
            "other"
          ]
        },
        "type": {
          "type": "string"
        },
        "raw_entity_mention": {
          "type": [
            "string",
            "null"
          ],
          "description": "Raw transcript/entity mention before canonical name resolution. Required for player takes."
        },
        "entity": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical full entity name only when verified with sufficient confidence; null when unresolved."
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_resolution": {
          "$ref": "#/$defs/entity_resolution"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "podcast_take": {
          "type": "string"
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentiment": {
          "type": "string"
        },
        "conviction": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity_resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "confidence",
        "reason",
        "candidates",
        "verified_sources"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "ambiguous",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "match_reason"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "position": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "college": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "match_reason": {
                "type": "string"
              }
            }
          }
        },
        "verified_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
