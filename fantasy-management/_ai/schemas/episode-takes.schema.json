{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/episode-takes.schema.json",
  "title": "Podcast Episode Takes Entry Point",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "episode_id",
        "source_id",
        "source_name",
        "take_categories"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "take_categories": {
          "type": "object",
          "required": [
            "players",
            "teams",
            "positions",
            "nfl",
            "fantasy",
            "other"
          ],
          "additionalProperties": false,
          "properties": {
            "players": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            },
            "teams": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            },
            "positions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            },
            "nfl": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            },
            "fantasy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            },
            "other": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/take"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "source_id",
        "source_name",
        "storage_mode",
        "take_counts",
        "parts"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "storage_mode": {
          "const": "split"
        },
        "take_counts": {
          "type": "object",
          "required": [
            "players",
            "teams",
            "positions",
            "nfl",
            "fantasy",
            "other"
          ],
          "additionalProperties": false,
          "properties": {
            "players": {
              "type": "integer",
              "minimum": 0
            },
            "teams": {
              "type": "integer",
              "minimum": 0
            },
            "positions": {
              "type": "integer",
              "minimum": 0
            },
            "nfl": {
              "type": "integer",
              "minimum": 0
            },
            "fantasy": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "parts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "path",
              "count"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "players",
                  "teams",
                  "positions",
                  "nfl",
                  "fantasy",
                  "other"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^takes/[^/]+\\.json$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "take": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "category",
        "type",
        "entity",
        "podcast_take",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "players",
            "teams",
            "positions",
            "nfl",
            "fantasy",
            "other"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "raw_entity_mention": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_resolution": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "status",
            "method",
            "confidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "ambiguous",
                "unresolved"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "registry",
                "external_verification",
                "context_inference",
                "manual_confirmation",
                "none"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "verified_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "podcast_take": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentiment": {
          "type": "string"
        },
        "conviction": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "required": [
            "timestamp_start"
          ],
          "additionalProperties": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "players"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "required": [
              "raw_entity_mention",
              "entity_resolution",
              "formats",
              "reasoning",
              "risks",
              "sentiment",
              "conviction",
              "tags"
            ]
          }
        }
      ]
    }
  }
}
