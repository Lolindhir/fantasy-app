{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/automation-observation-profile.schema.json",
  "title": "Fantasy Management Observation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "applicable_entity_types",
    "evaluator",
    "signals",
    "source_policy",
    "criteria",
    "output_fields"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applicable_entity_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version",
        "workflow_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "deterministic",
            "llm",
            "hybrid"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "value_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "enum",
              "list",
              "object"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            }
          },
          "source_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "value_type": {
                  "const": "enum"
                }
              }
            },
            "then": {
              "required": [
                "allowed_values"
              ]
            }
          }
        ]
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_confidence",
        "minimum_independent_sources",
        "allow_single_authoritative_source",
        "preferred_source_types"
      ],
      "properties": {
        "minimum_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "minimum_independent_sources": {
          "type": "integer",
          "minimum": 1
        },
        "allow_single_authoritative_source": {
          "type": "boolean"
        },
        "preferred_source_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_binding"
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "output_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "condition",
        "materiality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "materiality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_material",
            "severity",
            "classification"
          ],
          "properties": {
            "is_material": {
              "type": "boolean"
            },
            "severity": {
              "$ref": "#/$defs/severity"
            },
            "classification": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "effect": {
          "type": "object"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal",
            "operator"
          ],
          "properties": {
            "signal": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "not_equals",
                "gt",
                "gte",
                "lt",
                "lte",
                "delta_gte",
                "delta_lte",
                "absolute_delta_gte",
                "changed",
                "entered_set",
                "left_set",
                "contains",
                "not_contains"
              ]
            },
            "value": {},
            "comparison_window": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "provider",
        "dataset_id",
        "role",
        "required",
        "independence_group",
        "access",
        "entity_join",
        "signal_mappings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "derived"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "independence_group": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "location",
            "selection_policy"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "repo_latest_pointer",
                "repo_file",
                "web",
                "connector",
                "derived"
              ]
            },
            "location": {
              "type": [
                "string",
                "null"
              ]
            },
            "selection_policy": {
              "type": "string",
              "enum": [
                "latest_successful_snapshot",
                "current_file",
                "live_fetch",
                "connector_current",
                "derived"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "repo_latest_pointer",
                      "repo_file",
                      "web",
                      "connector"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "location": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "derived"
                  }
                }
              },
              "then": {
                "properties": {
                  "location": {
                    "type": "null"
                  },
                  "selection_policy": {
                    "const": "derived"
                  }
                }
              }
            }
          ]
        },
        "entity_join": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "signal_mappings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refresh_before_analysis"
          ],
          "properties": {
            "max_age_hours": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "refresh_before_analysis": {
              "type": "boolean"
            }
          }
        },
        "format_context": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
