{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/automation-observation-profile.schema.json",
  "title": "Fantasy Management Observation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "applicable_entity_types",
    "evaluator",
    "signals",
    "source_policy",
    "criteria",
    "output_fields"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applicable_entity_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version",
        "workflow_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "deterministic",
            "llm",
            "hybrid"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "value_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "enum",
              "list",
              "object"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_confidence",
        "minimum_independent_sources",
        "allow_single_authoritative_source",
        "preferred_source_types"
      ],
      "properties": {
        "minimum_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "minimum_independent_sources": {
          "type": "integer",
          "minimum": 1
        },
        "allow_single_authoritative_source": {
          "type": "boolean"
        },
        "preferred_source_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "output_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "condition",
        "materiality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "materiality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_material",
            "severity",
            "classification"
          ],
          "properties": {
            "is_material": {
              "type": "boolean"
            },
            "severity": {
              "$ref": "#/$defs/severity"
            },
            "classification": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          }
        },
        "effect": {
          "type": "object"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal",
            "operator"
          ],
          "properties": {
            "signal": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "not_equals",
                "gt",
                "gte",
                "lt",
                "lte",
                "delta_gte",
                "delta_lte",
                "absolute_delta_gte",
                "changed",
                "entered_set",
                "left_set",
                "contains",
                "not_contains"
              ]
            },
            "value": {},
            "comparison_window": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    }
  }
}
