{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/episode-takes-part.schema.json",
  "title": "Podcast Episode Takes Part",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "source_id",
    "source_name",
    "category",
    "takes"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "players",
        "teams",
        "positions",
        "nfl",
        "fantasy",
        "other"
      ]
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/take"
      }
    }
  },
  "$defs": {
    "take": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "category",
        "type",
        "entity",
        "podcast_take",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "players",
            "teams",
            "positions",
            "nfl",
            "fantasy",
            "other"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "raw_entity_mention": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "team": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_resolution": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "status",
            "method",
            "confidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "ambiguous",
                "unresolved"
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "registry",
                "external_verification",
                "context_inference",
                "manual_confirmation",
                "none"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "verified_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "podcast_take": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentiment": {
          "type": "string"
        },
        "conviction": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "required": [
            "timestamp_start"
          ],
          "additionalProperties": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "players"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "required": [
              "raw_entity_mention",
              "entity_resolution",
              "formats",
              "reasoning",
              "risks",
              "sentiment",
              "conviction",
              "tags"
            ]
          }
        }
      ]
    }
  }
}
