{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/automation-observation-state-batch.schema.json",
  "title": "Fantasy Management Observation State Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "checkpoint_id",
    "mode",
    "evaluated_at",
    "expected_revision",
    "expected_parent_sha",
    "expected_state_blob_sha",
    "status_after",
    "pending_after",
    "pair_results",
    "recent_event"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "job_id": {"const": "entity-observation"},
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
    },
    "mode": {
      "type": "string",
      "enum": ["bootstrap", "monitoring"]
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "expected_parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_state_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status_after": {
      "type": "string",
      "enum": ["idle", "pending", "succeeded"]
    },
    "pending_after": {"type": "boolean"},
    "job_error_after": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "message", "retryable"],
          "properties": {
            "at": {"type": "string", "format": "date-time"},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"}
          }
        }
      ]
    },
    "input_fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "target_set_updates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolved_target_ids"],
        "properties": {
          "last_resolved_at": {"type": "string", "format": "date-time"},
          "resolved_target_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "pair_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pair_result"}
    },
    "recent_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "type", "severity", "summary"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "type": {
          "type": "string",
          "enum": ["evaluated", "pending", "error", "recovered"]
        },
        "severity": {"$ref": "#/$defs/severity"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "keep_recent_events": {"type": "integer", "minimum": 0, "maximum": 100}
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "pair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "entity_fingerprint",
        "target_set_ids",
        "profile_id",
        "outcome",
        "source_fingerprints"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "entity_fingerprint": {"type": "string", "minLength": 1},
        "target_set_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "baseline",
            "unchanged",
            "material_change",
            "pending",
            "failed",
            "disabled"
          ]
        },
        "last_checked_at": {"type": "string", "format": "date-time"},
        "material_state": {"type": "object"},
        "confidence": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/confidence"}]
        },
        "state_hash": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "source_fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "last_material_change_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "last_error": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "preserve_previous_good_state": {"type": "boolean"}
      }
    }
  }
}
