{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/episode-index.schema.json",
  "title": "Podcast Episode Package Index",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "episode_id",
    "source_id",
    "source_name",
    "title",
    "status",
    "package_path",
    "files",
    "take_counts"
  ],
  "properties": {
    "package_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "episode_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "episode_number": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "processed_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "package_path": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "raw_manifest": {
          "type": "string"
        },
        "episode_summary": {
          "type": "string"
        },
        "takes": {
          "type": "string"
        },
        "mentions": {
          "type": "string"
        }
      }
    },
    "raw_status": {
      "type": "string"
    },
    "take_counts": {
      "type": "object",
      "required": [
        "players",
        "teams",
        "positions",
        "nfl",
        "fantasy",
        "other"
      ],
      "properties": {
        "players": {
          "type": "integer",
          "minimum": 0
        },
        "teams": {
          "type": "integer",
          "minimum": 0
        },
        "positions": {
          "type": "integer",
          "minimum": 0
        },
        "nfl": {
          "type": "integer",
          "minimum": 0
        },
        "fantasy": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mention_counts": {
      "type": "object",
      "required": [
        "total",
        "resolved",
        "ambiguous",
        "unresolved",
        "ranking_subjects",
        "substantive_subjects",
        "context_only",
        "with_take_links",
        "uncovered"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "ranking_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "substantive_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "context_only": {
          "type": "integer",
          "minimum": 0
        },
        "with_take_links": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage_audit": {
      "type": "object",
      "required": [
        "status",
        "method",
        "uncovered_mentions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "needs_review",
            "completed"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncovered_mentions": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledge_derivation_status": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package_schema_version": {
            "minimum": 2
          }
        },
        "required": [
          "package_schema_version"
        ]
      },
      "then": {
        "required": [
          "mention_counts",
          "coverage_audit"
        ],
        "properties": {
          "files": {
            "required": [
              "mentions"
            ]
          }
        }
      }
    }
  ]
}
