{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/operations-source-catalog.schema.json",
  "title": "Fantasy Operations Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "purpose", "sources", "derived_views"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "fantasy-operations-source-catalog"},
    "purpose": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "active", "source_kind", "provider", "dataset_id", "access", "applicability", "absence_policy", "join", "output", "roles", "quality", "freshness", "format_context"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "active": {"type": "boolean"},
          "source_kind": {"enum": ["expert_consensus", "market_value", "adp", "projection", "usage", "injury", "transaction", "other"]},
          "provider": {"type": "string", "minLength": 1},
          "dataset_id": {"type": "string", "minLength": 1},
          "access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "location", "ranking_path_field", "timestamp_fields"],
            "properties": {
              "type": {"const": "repo_latest_pointer"},
              "location": {"type": "string", "minLength": 1},
              "ranking_path_field": {"type": "string", "minLength": 1},
              "timestamp_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_types", "positions"],
            "properties": {
              "entity_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "positions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          },
          "absence_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inapplicable", "missing", "ambiguous"],
            "properties": {
              "inapplicable": {"const": "not_applicable"},
              "missing": {"const": "not_listed"},
              "ambiguous": {"const": "ambiguous_join"}
            }
          },
          "join": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategies"],
            "properties": {
              "strategies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "method", "player_field", "source_field"],
                      "properties": {
                        "type": {"const": "id"},
                        "method": {"type": "string", "minLength": 1},
                        "player_field": {"type": "string", "minLength": 1},
                        "source_field": {"type": "string", "minLength": 1}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "method", "name_field", "position_field"],
                      "properties": {
                        "type": {"const": "name_position"},
                        "method": {"type": "string", "minLength": 1},
                        "name_field": {"type": "string", "minLength": 1},
                        "position_field": {"type": "string", "minLength": 1},
                        "team_field": {"type": "string", "minLength": 1}
                      }
                    }
                  ]
                }
              }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "key", "signals"],
            "properties": {
              "section": {"type": "string", "minLength": 1},
              "key": {"type": "string", "minLength": 1},
              "signals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["target", "source_field", "type"],
                  "properties": {
                    "target": {"type": "string", "minLength": 1},
                    "source_field": {"type": "string", "minLength": 1},
                    "type": {"enum": ["text", "number", "boolean"]},
                    "transform": {"enum": ["percentile_from_rank"]}
                  }
                }
              }
            }
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "primary_for_positions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum_rows", "missing_severity", "ambiguous_severity", "row_count_severity"],
            "properties": {
              "minimum_rows": {"type": "integer", "minimum": 0},
              "missing_severity": {"enum": ["none", "info", "warning", "error"]},
              "ambiguous_severity": {"enum": ["none", "info", "warning", "error"]},
              "row_count_severity": {"enum": ["none", "info", "warning", "error"]}
            }
          },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_age_hours"],
            "properties": {"max_age_hours": {"type": "integer", "minimum": 1}}
          },
          "format_context": {"type": "object"}
        }
      }
    },
    "derived_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redraft_adp"],
      "properties": {
        "redraft_adp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_source_rule", "format_gap"],
          "properties": {
            "primary_source_rule": {"const": "roles.primary_for_positions"},
            "format_gap": {
              "type": "object",
              "additionalProperties": false,
              "required": ["left_source_id", "right_source_id", "signal"],
              "properties": {
                "left_source_id": {"type": "string", "minLength": 1},
                "right_source_id": {"type": "string", "minLength": 1},
                "signal": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
