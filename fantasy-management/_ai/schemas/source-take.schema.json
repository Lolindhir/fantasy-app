{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lolindhir/fantasy-app/fantasy-management/_ai/schemas/source-take.schema.json",
  "title": "Fantasy Management Source Take",
  "type": "object",
  "additionalProperties": true,
  "required": ["take_id", "source_name", "take_type", "fantasy_context", "sentiment", "conviction", "evidence"],
  "properties": {
    "take_id": { "type": "string" },
    "source_id": { "type": ["string", "null"] },
    "source_name": { "type": "string" },
    "source_type": { "type": "string" },
    "episode_id": { "type": ["string", "null"] },
    "published_date": { "type": ["string", "null"] },
    "processed_date": { "type": ["string", "null"] },
    "player_id": { "type": ["string", "null"] },
    "player_name": { "type": ["string", "null"] },
    "team_abbr": { "type": ["string", "null"] },
    "entity_type": { "type": ["string", "null"] },
    "take_type": {
      "type": "string",
      "enum": [
        "player_evaluation",
        "ranking",
        "tier",
        "sleeper",
        "buy",
        "sell",
        "hold",
        "fade",
        "watchlist",
        "trade_strategy",
        "draft_strategy",
        "rookie_draft_value",
        "redraft_value",
        "bestball_value",
        "dynasty_value",
        "injury_reaction",
        "availability_update",
        "depth_chart_projection",
        "role_projection",
        "coaching_scheme",
        "news_reaction",
        "market_adp",
        "format_note",
        "league_settings_note",
        "meta_strategy",
        "uncertainty",
        "other"
      ]
    },
    "claim_type": {
      "type": "string",
      "enum": ["fact", "news", "opinion", "projection", "rumor", "market", "strategy", "unknown"]
    },
    "fantasy_context": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["dynasty", "rookie_draft", "startup", "redraft", "bestball", "waiver", "trade", "devy", "general_fantasy", "real_football", "unknown"]
      }
    },
    "league_format_context": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sentiment": {
      "type": "string",
      "enum": ["very_positive", "positive", "mixed", "cautious", "negative", "very_negative", "neutral"]
    },
    "conviction": {
      "type": "string",
      "enum": ["very_high", "high", "medium", "low", "very_low", "unknown"]
    },
    "action": { "type": "string" },
    "time_horizon": { "type": "string" },
    "arguments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "timestamp_start": { "type": ["string", "null"] },
          "timestamp_end": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "validity_type": {
      "type": "string",
      "enum": ["point_in_time", "until_updated", "season_long", "evergreen", "decays_fast", "unknown"]
    },
    "freshness_bucket": {
      "type": "string",
      "enum": ["short", "medium", "long", "evergreen", "unknown"]
    },
    "stale_after_days": { "type": ["integer", "null"] },
    "current_relevance": {
      "type": "string",
      "enum": ["active", "stale", "superseded", "resolved", "contradicted", "historical_context", "unknown"]
    },
    "supersedes_take_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_by_take_id": { "type": ["string", "null"] },
    "source_weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "extractor_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    }
  }
}
