{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy Entity Signal",
  "type": "object",
  "additionalProperties": true,
  "required": ["entity_type", "entity_name", "last_updated", "signals"],
  "properties": {
    "entity_type": { "type": "string" },
    "entity_id": { "type": ["string", "null"] },
    "entity_name": { "type": "string" },
    "team_abbr": { "type": ["string", "null"] },
    "last_updated": { "type": "string" },
    "summary": { "type": "array", "items": { "type": "string" } },
    "direction": { "type": "string" },
    "agreement": { "type": "string" },
    "signals": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "inactive_signals": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
