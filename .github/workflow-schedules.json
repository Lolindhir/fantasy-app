        "workflow_dispatch"
      ]
    },
    {
      "id": "backup-cleanup",
      "workflow": "clean-backups.yml",
      "path": ".github/workflows/clean-backups.yml",
      "eventType": "scheduler-clean-backups",
      "profile": "maintenance",
      "timezone": "Europe/Berlin",
      "cron": [
        "0 17 * * 3"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "id": "workflow-health",
      "workflow": "workflow-health-snapshot.yml",
      "path": ".github/workflows/workflow-health-snapshot.yml",
      "eventType": "scheduler-workflow-health",
      "profile": "observer",
      "timezone": "Etc/UTC",
      "cron": [
        "7-59/30 * * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ],
      "maxStarvationMinutes": 30,
      "deferUntilOtherTargetsSettled": {
        "maxMinutes": 20
      }
    },
    {
      "id": "ci-full-audit",
      "workflow": "build.yml",
      "path": ".github/workflows/build.yml",
      "eventType": "scheduler-ci-full-audit",
      "profile": "audit",
      "timezone": "Europe/Berlin",
      "cron": [
        "15 2 * * 4"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ]
    }
  ]
}
