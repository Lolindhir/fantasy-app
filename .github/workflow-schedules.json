      "timezone": "Etc/UTC",
      "cron": [
        "*/10 * * * *"
      ],
      "mode": "game-window",
      "gameWindow": {
        "preKickoffMinutes": 2880,
        "postFinalMinutes": 60,
        "idleCron": [
          "7 */6 * 9-12,1 *"
        ]
      },
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ]
    },
    {
