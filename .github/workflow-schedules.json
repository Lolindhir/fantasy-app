      "eventType": "scheduler-sync-nfl-player-availability",
      "profile": "productive",
      "timezone": "Europe/Berlin",
      "cron": [
        "9-59/10 * * 9-12,1 *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ]
    },
    {
      "id": "league-source",
      "workflow": "sync-league-source-data.yml",
      "path": ".github/workflows/sync-league-source-data.yml",
      "eventType": "scheduler-sync-league-source-data",
      "profile": "productive",
      "timezone": "Europe/Berlin",
      "cron": [
        "30 4 * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch",
        "push"
      ]
    },
    {
      "id": "source-data-readiness",
      "workflow": "source-data-readiness.yml",
      "path": ".github/workflows/source-data-readiness.yml",
      "eventType": "scheduler-source-data-readiness",
      "profile": "observer",
      "timezone": "Europe/Berlin",
      "cron": [
        "0 5 * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch",
        "push"
      ]
    },
    {
      "id": "fm-daily",
      "workflow": "fm-daily.yml",
      "path": ".github/workflows/fm-daily.yml",
      "eventType": "scheduler-fm-daily",
      "profile": "productive",
      "timezone": "Europe/Berlin",
      "cron": [
        "20 5 * * *"
      ],
      "satisfyingEvents": [
