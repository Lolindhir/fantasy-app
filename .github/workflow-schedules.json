{
  "schemaVersion": 2,
  "repository": "Lolindhir/fantasy-app",
  "ref": "main",
  "lookbackMinutes": 11520,
  "summaryTimezone": "Europe/Berlin",
  "dispatchObservation": {
    "timeoutMinutes": 15
  },
  "apiErrorPolicy": {
    "failAfterConsecutiveTicks": 2
  },
  "state": {
    "schemaVersion": 1,
    "branch": "workflow-scheduler-state",
    "path": "workflow-scheduler-state.json"
  },
  "projectFieldSync": {
    "workflow": "sync-project-fields.yml",
    "eventType": "scheduler-sync-project-fields",
    "quietMinutes": 5,
    "maxWaitMinutes": 30,
    "bootstrapLookbackMinutes": 30
  },
  "retryPolicies": {
    "standard": {
      "maxAttempts": 3,
      "backoffMinutes": [
        5,
        10
      ],
      "cooldownMinutes": 60
    },
    "audit-once": {
      "maxAttempts": 1,
      "backoffMinutes": [],
      "cooldownMinutes": 60
    }
  },
  "profiles": {
    "productive": {
      "healthBarrier": true,
      "retryPolicy": "standard"
    },
    "maintenance": {
      "healthBarrier": false,
      "retryPolicy": "standard"
    },
    "observer": {
      "healthBarrier": false,
      "retryPolicy": "standard"
    },
    "audit": {
      "healthBarrier": false,
      "retryPolicy": "audit-once"
    }
  },
  "targets": [
    {
      "id": "league-live",
      "workflow": "league-live.yml",
      "path": ".github/workflows/league-live.yml",
      "eventType": "scheduler-league-live",
      "profile": "productive",
      "timezone": "Etc/UTC",
      "cron": [
        "*/10 * * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ]
    },
    {
      "id": "players",
      "workflow": "update-players.yml",
      "path": ".github/workflows/update-players.yml",
      "eventType": "scheduler-update-players",
      "profile": "productive",
      "timezone": "America/New_York",
      "cron": [
        "15 1 * * *",
        "0 8 * * *",
        "30 13 * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "id": "standings",
      "workflow": "update-standings.yml",
      "path": ".github/workflows/update-standings.yml",
      "eventType": "scheduler-update-standings",
      "profile": "productive",
      "timezone": "America/New_York",
      "cron": [
        "35 3 * * 3"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "id": "transactions",
      "workflow": "update-transactions.yml",
      "path": ".github/workflows/update-transactions.yml",
      "eventType": "scheduler-update-transactions",
      "profile": "productive",
      "timezone": "America/New_York",
      "cron": [
        "5 4 * * 3"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "id": "teams",
      "workflow": "update-teams.yml",
      "path": ".github/workflows/update-teams.yml",
      "eventType": "scheduler-update-teams",
      "profile": "productive",
      "timezone": "America/New_York",
      "cron": [
        "35 4 * * 3"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "id": "nfl-source",
      "workflow": "sync-nfl-source-data.yml",
      "path": ".github/workflows/sync-nfl-source-data.yml",
      "eventType": "scheduler-sync-nfl-source-data",
      "profile": "productive",
      "timezone": "Europe/Berlin",
      "cron": [
        "0 4 * * *"
      ],
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch",
        "push"
      ]
    },
    {
      "id": "nfl-live",
      "workflow": "nfl-live.yml",
      "path": ".github/workflows/nfl-live.yml",
      "eventType": "scheduler-nfl-live",
      "profile": "productive",
      "timezone": "Europe/Berlin",
      "cron": [
        "*/10 * * * *"
      ],
      "mode": "game-window",
      "gameWindow": {
        "preKickoffMinutes": 15,
        "postFinalMinutes": 60,
        "idleCron": [
          "7 */6 * 9-12,1 *"
        ]
      },
      "satisfyingEvents": [
        "repository_dispatch",
        "workflow_dispatch"
      ]
    },
    {
      "id": "nfl-odds-refresh",
