  "retryPolicies": {
    "standard": {
      "maxAttempts": 3,
      "backoffMinutes": [5, 10],
      "cooldownMinutes": 60
    }
  },
  "profiles": {
    "productive": {
      "healthBarrier": true,
      "retryPolicy": "standard"
    },
    "maintenance": {
      "healthBarrier": false,
      "retryPolicy": "standard"
    },
    "observer": {
      "healthBarrier": false,
      "retryPolicy": "standard"
    }
  },
