{
  "schemaVersion": 2,
  "datasets": [
    {
      "id": "nflverse.players",
      "provider": "nflverse",
      "upstream": "nflverse/nflverse-data",
      "sourceUrl": "https://github.com/nflverse/nflverse-data/releases/download/players/players.csv",
      "sourceFormat": "csv",
      "rawPath": "providers/nflverse/players/raw-latest.csv",
      "metadataPath": "providers/nflverse/players/metadata.json",
      "requiredColumns": ["gsis_id", "display_name", "pfr_id", "position"],
      "minimumRows": 5000,
      "kind": "identity",
      "refreshPolicy": "periodic",
      "retentionPolicy": "latest-with-git-history",
      "lifecycle": {
        "class": "dynamic",
        "partitionKey": "none",
        "finalization": "never",
        "repairPolicy": "normal"
      },
      "license": "CC BY 4.0",
      "attribution": "nflverse"
    },
    {
      "id": "nflverse.ff-player-ids",
      "provider": "nflverse-ffverse",
      "upstream": "dynastyprocess/data",
      "sourceUrl": "https://raw.githubusercontent.com/dynastyprocess/data/master/files/db_playerids.csv",
      "sourceFormat": "csv",
      "rawPath": "providers/nflverse/ff-player-ids/raw-latest.csv",
      "metadataPath": "providers/nflverse/ff-player-ids/metadata.json",
      "requiredColumns": ["mfl_id", "gsis_id", "sleeper_id", "espn_id", "pfr_id", "name", "draft_year", "draft_round", "draft_pick", "draft_ovr"],
      "minimumRows": 5000,
      "kind": "identity-mapping",
      "refreshPolicy": "periodic",
      "retentionPolicy": "latest-with-git-history",
      "lifecycle": {
        "class": "dynamic",
        "partitionKey": "none",
        "finalization": "never",
        "repairPolicy": "normal"
      },
      "license": "CC BY 4.0",
      "attribution": "DynastyProcess data via nflverse/ffverse"
    },
    {
      "id": "nflverse.draft-picks",
      "provider": "nflverse",
      "upstream": "nflverse/nflverse-data",
      "sourceUrl": "https://github.com/nflverse/nflverse-data/releases/download/draft_picks/draft_picks.csv",
      "sourceFormat": "csv",
      "rawPath": "providers/nflverse/draft-picks/raw-latest.csv",
      "metadataPath": "providers/nflverse/draft-picks/metadata.json",
      "requiredColumns": ["season", "round", "pick", "team", "gsis_id", "pfr_player_id", "pfr_player_name", "position"],
      "minimumRows": 5000,
      "kind": "historical-event",
      "refreshPolicy": "discover-new-partitions",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "immutable-history",
        "partitionKey": "season",
        "finalization": "freeze-existing-partitions",
        "repairPolicy": "explicit-force"
      },
      "license": "CC BY 4.0",
      "attribution": "nflverse; draft data via Pro Football Reference"
    },
    {
      "id": "nflverse.combine",
      "provider": "nflverse",
      "upstream": "nflverse/nflverse-data",
      "sourceUrl": "https://github.com/nflverse/nflverse-data/releases/download/combine/combine.csv",
      "sourceFormat": "csv",
      "rawPath": "providers/nflverse/combine/raw-latest.csv",
      "metadataPath": "providers/nflverse/combine/metadata.json",
      "requiredColumns": ["season", "draft_year", "draft_team", "draft_round", "draft_ovr", "pfr_id", "cfb_id", "player_name", "pos", "school", "ht", "wt", "forty", "bench", "vertical", "broad_jump", "cone", "shuttle"],
      "minimumRows": 7000,
      "kind": "athletic-measurement-history",
      "refreshPolicy": "discover-new-partitions",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "immutable-history",
        "partitionKey": "season",
        "finalization": "freeze-existing-partitions",
        "repairPolicy": "explicit-force"
      },
      "license": "CC BY 4.0",
      "attribution": "nflverse; NFL Combine data courtesy of Pro Football Reference"
    }
  ],
  "plannedDatasets": [
    {
      "id": "nflverse.rosters",
      "kind": "seasonal-roster",
      "refreshPolicy": "current-season",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "seasonal-finalizable",
        "partitionKey": "season",
        "finalization": "freeze-prior-seasons",
        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.weekly-rosters",
