        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.schedules",
      "kind": "schedule",
      "refreshPolicy": "current-season",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "seasonal-finalizable",
        "partitionKey": "season",
        "finalization": "freeze-prior-seasons",
        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.player-stats",
      "kind": "weekly-player-stats",
      "refreshPolicy": "current-season",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "seasonal-finalizable",
        "partitionKey": "season-week",
        "finalization": "freeze-prior-seasons",
        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.snap-counts",
      "kind": "weekly-snap-counts",
      "refreshPolicy": "current-season",
      "retentionPolicy": "permanent-by-season",
      "lifecycle": {
        "class": "seasonal-finalizable",
        "partitionKey": "season-week",
        "finalization": "freeze-prior-seasons",
        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.depth-charts",
      "kind": "depth-chart-snapshot",
      "refreshPolicy": "snapshot",
      "retentionPolicy": "permanent-snapshots",
      "lifecycle": {
        "class": "snapshot",
        "partitionKey": "snapshot-time",
        "finalization": "append-only-snapshots",
        "repairPolicy": "explicit-force"
      }
    },
    {
      "id": "nflverse.contracts",
      "kind": "contract-snapshot",
      "refreshPolicy": "snapshot",
      "retentionPolicy": "permanent-snapshots",
      "lifecycle": {
        "class": "snapshot",
        "partitionKey": "snapshot-time",
        "finalization": "append-only-snapshots",
        "repairPolicy": "explicit-force"
      }
